# Optional fallback. Users can paste their own Spoonacular key in Frij's
# Settings page (gear icon in the dock), and that key is used first.
# This server key is only used when a user hasn't saved one - leave it empty
# on a public deployment so nobody spends YOUR daily quota.
# Free keys: https://spoonacular.com/food-api (150 points/day)
SPOONACULAR_API_KEY=

# Optional - only needed for the receipt/shelf photo scanner (📷 Scan items).
# This is a PAID API, unlike Spoonacular's free tier - check current pricing
# at docs.claude.com before enabling. The rest of the app works fine without it.
ANTHROPIC_API_KEY=
